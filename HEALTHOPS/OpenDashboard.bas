Attribute VB_Name = "OpenDashboard"
Option Explicit

' =============================================================================
' HEALTHOPS - Open Dashboard macro
'
' Reads every PivotTable on the Healthcare_Pivots sheet, writes their rendered
' values to HEALTHOPS\src\taskpane\data.js, then opens the dashboard in the
' default browser. Nothing is hardcoded - all values are read at click time.
'
' Expected folder layout (relative to this workbook):
'     <root>\Excel_Workbook\Excel_Workbook.xlsm   <- this workbook
'     <root>\HEALTHOPS\src\taskpane\taskpane.html
'
' Install: Developer > Visual Basic > File > Import File... > OpenDashboard.bas
' Run:     Alt+F8 > OpenHealthOpsDashboard  (or assign it to a button)
' Button:  select the launcher sheet, then Alt+F8 > BuildDashboardLauncher
'          (draws the styled launcher card; safe to re-run)
' =============================================================================

Private Const DASHBOARD_FOLDER As String = "..\HEALTHOPS\src\taskpane\"
Private Const DATA_FILE_NAME As String = "data.js"
Private Const DASHBOARD_HTML As String = "taskpane.html"
Private Const PIVOT_SHEET_NAME As String = "Healthcare_Pivots"

Public Sub OpenHealthOpsDashboard()
    Dim ws As Worksheet
    Dim pt As PivotTable
    Dim fso As Object
    Dim folderPath As String
    Dim js As String
    Dim isFirst As Boolean
    Dim pivotCount As Long

    On Error GoTo ErrHandler

    If Len(ThisWorkbook.Path) = 0 Then
        Err.Raise vbObjectError + 1, , "Save the workbook first so the HEALTHOPS folder can be located."
    End If

    Set ws = ThisWorkbook.Worksheets(PIVOT_SHEET_NAME)

    Set fso = CreateObject("Scripting.FileSystemObject")
    folderPath = fso.GetAbsolutePathName(ThisWorkbook.Path & "\" & DASHBOARD_FOLDER)
    If Not fso.FolderExists(folderPath) Then
        Err.Raise vbObjectError + 2, , "Dashboard folder not found:" & vbCrLf & folderPath
    End If

    Application.StatusBar = "HEALTHOPS: exporting PivotTables..."

    js = "// Generated by the OpenHealthOpsDashboard macro - do not edit by hand." & vbLf
    js = js & "window.HEALTHOPS_DATA = {" & vbLf
    js = js & "  ""generatedAt"": """ & Format$(Now, "yyyy-mm-dd") & "T" & Format$(Now, "hh:nn:ss") & """," & vbLf
    js = js & "  ""workbook"": """ & JsEscape(ThisWorkbook.Name) & """," & vbLf
    js = js & "  ""pivots"": {" & vbLf

    isFirst = True
    For Each pt In ws.PivotTables
        If Not isFirst Then js = js & "," & vbLf
        isFirst = False
        js = js & "    """ & JsEscape(pt.Name) & """: " & RangeToJsArray(pt.TableRange2)
        pivotCount = pivotCount + 1
    Next pt

    If pivotCount = 0 Then
        Err.Raise vbObjectError + 3, , "No PivotTables found on the " & PIVOT_SHEET_NAME & " sheet."
    End If

    js = js & vbLf & "  }" & vbLf & "};" & vbLf

    WriteUtf8 fso.BuildPath(folderPath, DATA_FILE_NAME), js

    Application.StatusBar = False
    ThisWorkbook.FollowHyperlink fso.BuildPath(folderPath, DASHBOARD_HTML)
    Exit Sub

ErrHandler:
    Application.StatusBar = False
    MsgBox "Could not open the HEALTHOPS dashboard." & vbCrLf & vbCrLf & _
           "Error: " & Err.Description & vbCrLf & vbCrLf & _
           "Check that the HEALTHOPS folder sits next to the Excel_Workbook folder " & _
           "and that the " & PIVOT_SHEET_NAME & " sheet and its PivotTables are intact.", _
           vbExclamation, "HEALTHOPS"
End Sub

' -----------------------------------------------------------------------------
' Launcher card
'
' Draws a dashboard launcher on the active sheet in the HEALTHOPS green palette:
' a white card with a soft shadow, an icon badge, title, description, a
' gradient "Open Dashboard" button. The whole card is
' clickable. Re-running replaces the previous launcher, any older shape wired
' to OpenHealthOpsDashboard, and the old caption text under the button.
' -----------------------------------------------------------------------------
Public Sub BuildDashboardLauncher()
    Const PREFIX As String = "HEALTHOPS_"
    Const CARD_W As Single = 560
    Const CARD_H As Single = 204
    Const PAD As Single = 28

    Dim ws As Worksheet
    Dim anchor As Range
    Dim found As Range
    Dim shp As Shape
    Dim card As Shape, badge As Shape, eyebrow As Shape, title As Shape
    Dim desc As Shape, btn As Shape
    Dim grp As Shape
    Dim l As Single, t As Single
    Dim pivotCount As Long
    Dim i As Long

    Set ws = ActiveSheet
    Set anchor = ws.Range("D9")
    l = anchor.Left
    t = anchor.Top

    ' Remove a previous launcher and any older shape wired to the macro.
    For i = ws.Shapes.Count To 1 Step -1
        Set shp = ws.Shapes(i)
        If Left$(shp.Name, Len(PREFIX)) = PREFIX Or _
           InStr(1, ShapeAction(shp), "OpenHealthOpsDashboard", vbTextCompare) > 0 Then
            shp.Delete
        End If
    Next i

    ' Clear the old caption that sat under the previous button.
    Set found = ws.Cells.Find(What:="opens the HEALTHOPS analytics dashboard", _
                              LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
    If Not found Is Nothing Then found.MergeArea.ClearContents

    pivotCount = CountPivots()

    ' Card
    Set card = ws.Shapes.AddShape(msoShapeRoundedRectangle, l, t, CARD_W, CARD_H)
    card.Name = PREFIX & "Card"
    card.Adjustments.Item(1) = 0.08
    SolidFill card, "#FFFFFF"
    With card.Line
        .Visible = msoTrue
        .ForeColor.RGB = HexColor("#DAF6EA")
        .Weight = 1
    End With
    With card.Shadow
        .Visible = msoTrue
        .ForeColor.RGB = HexColor("#0B2A1D")
        .Transparency = 0.88
        .Blur = 22
        .OffsetX = 0
        .OffsetY = 8
        .Size = 100
    End With

    ' Icon badge
    Set badge = ws.Shapes.AddShape(msoShapeRoundedRectangle, l + PAD, t + PAD, 46, 46)
    badge.Name = PREFIX & "Badge"
    badge.Adjustments.Item(1) = 0.26
    GreenGradient badge
    badge.Line.Visible = msoFalse
    SetText badge, ChrW(&H271A), 20, True, "#FFFFFF", msoAlignCenter, "Segoe UI Symbol"

    ' Eyebrow + title
    Set eyebrow = AddLabel(ws, PREFIX & "Eyebrow", l + PAD + 62, t + PAD + 2, 420, 14)
    SetText eyebrow, "HEALTHCARE OPERATIONS ANALYTICS", 8.5, True, "#28845B", msoAlignLeft
    eyebrow.TextFrame2.TextRange.Font.Spacing = 1.2

    Set title = AddLabel(ws, PREFIX & "Title", l + PAD + 62, t + PAD + 16, 420, 30)
    SetText title, "HEALTHOPS Dashboard", 20, True, "#0B2A1D", msoAlignLeft, "Segoe UI Semibold"

    ' Description
    Set desc = AddLabel(ws, PREFIX & "Description", l + PAD, t + PAD + 62, CARD_W - 2 * PAD, 34)
    SetText desc, "Exports " & IIf(pivotCount > 0, pivotCount & " ", "the ") & _
                  "PivotTables from " & PIVOT_SHEET_NAME & _
                  " and opens the live analytics dashboard in your browser.", _
                  10.5, False, "#2F5A47", msoAlignLeft
    desc.TextFrame2.WordWrap = msoTrue

    ' Primary button
    Set btn = ws.Shapes.AddShape(msoShapeRoundedRectangle, l + (CARD_W - 214) / 2, t + CARD_H - PAD - 42, 214, 42)
    btn.Name = PREFIX & "Button"
    btn.Adjustments.Item(1) = 0.5
    GreenGradient btn
    btn.Line.Visible = msoFalse
    With btn.Shadow
        .Visible = msoTrue
        .ForeColor.RGB = HexColor("#16995F")
        .Transparency = 0.7
        .Blur = 12
        .OffsetX = 0
        .OffsetY = 4
        .Size = 100
    End With
    SetText btn, "Open Dashboard   " & ChrW(&H2192), 11.5, True, "#FFFFFF", msoAlignCenter, "Segoe UI Semibold"

    ' Group, make the whole card clickable, keep it from stretching with cells.
    Set grp = ws.Shapes.Range(Array(card.Name, badge.Name, eyebrow.Name, title.Name, _
                                    desc.Name, btn.Name)).Group
    grp.Name = PREFIX & "Launcher"
    grp.OnAction = "OpenHealthOpsDashboard"
    grp.Placement = xlFreeFloating
    grp.AlternativeText = "Open the HEALTHOPS analytics dashboard"

    anchor.Select
End Sub

Private Function CountPivots() As Long
    On Error Resume Next
    CountPivots = ThisWorkbook.Worksheets(PIVOT_SHEET_NAME).PivotTables.Count
End Function

' Some shapes (e.g. charts) raise an error when OnAction is read.
Private Function ShapeAction(ByVal shp As Shape) As String
    On Error Resume Next
    ShapeAction = shp.OnAction
End Function

Private Function AddLabel(ByVal ws As Worksheet, ByVal shapeName As String, _
                          ByVal l As Single, ByVal t As Single, _
                          ByVal w As Single, ByVal h As Single) As Shape
    Dim shp As Shape
    Set shp = ws.Shapes.AddTextbox(msoTextOrientationHorizontal, l, t, w, h)
    shp.Name = shapeName
    shp.Fill.Visible = msoFalse
    shp.Line.Visible = msoFalse
    Set AddLabel = shp
End Function

Private Sub SetText(ByVal shp As Shape, ByVal text As String, ByVal size As Single, _
                    ByVal isBold As Boolean, ByVal hexValue As String, _
                    ByVal align As MsoParagraphAlignment, _
                    Optional ByVal fontName As String = "Segoe UI")
    With shp.TextFrame2
        .MarginLeft = 0
        .MarginRight = 0
        .MarginTop = 0
        .MarginBottom = 0
        .VerticalAnchor = msoAnchorMiddle
        .WordWrap = msoFalse
        With .TextRange
            .Text = text
            .ParagraphFormat.Alignment = align
            .Font.Name = fontName
            .Font.Size = size
            .Font.Bold = IIf(isBold, msoTrue, msoFalse)
            .Font.Fill.ForeColor.RGB = HexColor(hexValue)
        End With
    End With
End Sub

Private Sub SolidFill(ByVal shp As Shape, ByVal hexValue As String)
    With shp.Fill
        .Visible = msoTrue
        .Solid
        .ForeColor.RGB = HexColor(hexValue)
        .Transparency = 0
    End With
End Sub

' Brand green gradient (light mint -> green -> deep green), diagonal.
Private Sub GreenGradient(ByVal shp As Shape)
    With shp.Fill
        .Visible = msoTrue
        .TwoColorGradient msoGradientDiagonalDown, 1
        .ForeColor.RGB = HexColor("#46CD90")
        .BackColor.RGB = HexColor("#16995F")
        .GradientStops.Insert HexColor("#3ECF8E"), 0.5
    End With
End Sub

Private Function HexColor(ByVal hexValue As String) As Long
    Dim h As String
    h = Replace(hexValue, "#", "")
    HexColor = RGB(CLng("&H" & Mid$(h, 1, 2)), CLng("&H" & Mid$(h, 3, 2)), CLng("&H" & Mid$(h, 5, 2)))
End Function

' Converts a PivotTable's rendered range into a JS 2D array literal:
' [["Row Labels","Cancelled",...],["Cardiology",385,...],...]
Private Function RangeToJsArray(ByVal rng As Range) As String
    Dim data As Variant
    Dim r As Long, c As Long
    Dim rowParts() As String
    Dim cellParts() As String

    ' Read the whole range in one call (much faster than cell by cell).
    If rng.Cells.Count = 1 Then
        ReDim data(1 To 1, 1 To 1)
        data(1, 1) = rng.Value
    Else
        data = rng.Value
    End If

    ReDim rowParts(1 To UBound(data, 1))
    For r = 1 To UBound(data, 1)
        ReDim cellParts(1 To UBound(data, 2))
        For c = 1 To UBound(data, 2)
            cellParts(c) = ValueToJs(data(r, c))
        Next c
        rowParts(r) = "[" & Join(cellParts, ",") & "]"
    Next r

    RangeToJsArray = "[" & Join(rowParts, ",") & "]"
End Function

' Converts a single cell value to its JS literal representation.
' Numbers are written locale-independently (always "." as decimal separator).
Private Function ValueToJs(ByVal v As Variant) As String
    If IsError(v) Then
        ValueToJs = "null"
    ElseIf IsEmpty(v) Then
        ValueToJs = """"""
    Else
        Select Case VarType(v)
            Case vbBoolean
                ValueToJs = IIf(v, "true", "false")
            Case vbByte, vbInteger, vbLong, vbSingle, vbDouble, vbCurrency, vbDecimal
                ValueToJs = Trim$(Str$(v))
                If Left$(ValueToJs, 1) = "." Then ValueToJs = "0" & ValueToJs
                If Left$(ValueToJs, 2) = "-." Then ValueToJs = "-0" & Mid$(ValueToJs, 2)
            Case vbDate
                ValueToJs = """" & Format$(v, "yyyy-mm-dd") & """"
            Case Else
                ValueToJs = """" & JsEscape(CStr(v)) & """"
        End Select
    End If
End Function

Private Function JsEscape(ByVal s As String) As String
    Dim result As String
    result = Replace(s, "\", "\\")
    result = Replace(result, """", "\""")
    result = Replace(result, vbCrLf, "\n")
    result = Replace(result, vbCr, "\n")
    result = Replace(result, vbLf, "\n")
    result = Replace(result, vbTab, "\t")
    result = Replace(result, "</", "<\/")
    JsEscape = result
End Function

' Writes text as UTF-8 so non-ASCII labels survive intact.
Private Sub WriteUtf8(ByVal filePath As String, ByVal text As String)
    Dim stream As Object
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2 ' adTypeText
    stream.Charset = "utf-8"
    stream.Open
    stream.WriteText text
    stream.SaveToFile filePath, 2 ' adSaveCreateOverWrite
    stream.Close
End Sub
